{
  "name": "sitka-app",
  "version": "1.13.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "MALLOC_ARENA_MAX=2 NODE_OPTIONS='--max-old-space-size=4096' node node_modules/next/dist/bin/next dev",
    "prebuild": "npm run generate",
    "build": "MALLOC_ARENA_MAX=2 NODE_OPTIONS='--max-old-space-size=4096' node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit -p .",
    "tokens:build": "node scripts/tokens/build.mjs",
    "figma:parse": "figma connect parse --outFile .figma/.parsed-react.json && figma connect parse --dir .figma/swiftui --outFile .figma/.parsed-swiftui.json",
    "figma:publish": "figma connect publish && figma connect publish --dir .figma/swiftui",
    "generate": "node scripts/tokens/build.mjs && node scripts/figma/drift.mjs && node scripts/agents/build.mjs",
    "figma:drift": "node scripts/figma/drift.mjs",
    "agents:build": "node scripts/agents/build.mjs",
    "version:sync": "node scripts/release/sync-versions.mjs",
    "version": "node scripts/release/sync-versions.mjs && npm run generate && git add -A packages/sitka-ui/package.json platforms/react-native/package.json src/tokens/tokens.json platforms/swift platforms/figma public/downloads public/llms.txt public/components.json src/site/home/figma-drift.json",
    "typecheck:stories": "tsc --noEmit -p tsconfig.stories.json",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "adoption": "node scripts/adoption/scan.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@figma/code-connect": "^1.4.4",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.18",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^24.0.0",
    "storybook": "^8.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4.0.0"
    }
  }
}
